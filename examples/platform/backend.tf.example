# Copy to backend.tf. Create the state storage account once (outside this stack), with
# shared-key access disabled and Entra ID auth for the deploy identity.
terraform {
  backend "azurerm" {
    resource_group_name  = "rg-tfstate"
    storage_account_name = "sttfstate00000"
    container_name       = "tfstate"
    key                  = "platform.tfstate"
    use_azuread_auth     = true
  }
}
